+def render_owned_jpeg_letterbox(
+    image: Image.Image,
+    spec: ThumbnailRenderSpec,
+) -> QImage | None:
+    """Consume a fresh caller-owned JPEG; None requests the ordinary renderer.
+
+    Never pass a shared/reusable PIL image here: draft changes decoder state.
+    The owner must reopen its source before fallback if this raises. Original
+    source metadata must be captured before entry, not from the reduced image.
+    """
+    if spec.crop_mode != "letterbox" or image.format != "JPEG" or image.mode not in {"RGB", "L"}:
+        return None
+    orientation = image.getexif().get(274, 1)
+    if type(orientation) is not int or orientation not in range(1, 9):
+        return None
+    swapped = orientation in {5, 6, 7, 8}
+    width, height = image.size[::-1] if swapped else image.size
+    bound_width, bound_height = spec.frame_width, spec.frame_height
+    if min(width, height, bound_width, bound_height) <= 0:
+        return None
+    if width <= bound_width and height <= bound_height:
+        return None
+    # Match the full renderer's integer aspect fit using ORIGINAL oriented
+    # dimensions, not the rounded dimensions produced by native JPEG scaling.
+    aspect = width / height
+    if width * bound_height <= height * bound_width:
+        exact = bound_height * aspect
+        fitted_width = max(1, min((math.floor(exact), math.ceil(exact)),
+                                  key=lambda value: abs(aspect - value / bound_height)))
+        target = (fitted_width, bound_height)
+    else:
+        exact = bound_width / aspect
+        fitted_height = max(1, min((math.floor(exact), math.ceil(exact)),
+                                   key=lambda value: abs(aspect - bound_width / value) if value else math.inf))
+        target = (bound_width, fitted_height)
+    raw_target = target[::-1] if swapped else target
+    # A 3x intermediate margin retains detail before the final LANCZOS resize.
+    # Pillow's draft box preserves fractional edges for odd JPEG dimensions.
+    drafted = image.draft(None, tuple(value * 3 for value in raw_target))
+    image.load()
+    with image.resize(raw_target, Image.Resampling.LANCZOS,
+                      box=drafted[1] if drafted else None,
+                      reducing_gap=3.0) as reduced:
+        with ImageOps.exif_transpose(reduced) as oriented:
+            return pil_to_qimage(oriented)
+
